    { "action": "tap", "label": "취소", "wait": 3000 },

    { "action": "tapContains", "contains": "사과", "wait": 6000 },
    { "action": "shot", "name": "03-cart-edit", "caption": "품목 수정 — 이름·단위·메모" },
    { "action": "tap", "label": "취소", "wait": 3000 },

