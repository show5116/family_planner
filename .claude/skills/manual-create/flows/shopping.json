    { "action": "tapFab", "wait": 6000 },
    { "action": "shot", "name": "05-frequent-form", "caption": "자주 사는 항목 추가" },
    { "action": "goto", "path": "/shopping", "wait": 12000 },

    { "action": "tap", "label": "구매 이력", "wait": 8000 },
