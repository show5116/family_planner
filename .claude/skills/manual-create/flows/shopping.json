    { "action": "login", "as": "owner", "wait": 16000 },
    { "action": "goto", "path": "/shopping", "wait": 14000 },
    { "action": "shot", "name": "01-cart", "caption": "장바구니 — 합계와 담은 품목" },

    { "action": "tapFab", "wait": 6000 },
